@import "../styles/tokens.wxss";

.tab {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--tab-bg);
  z-index: 20;
}

.tab-row {
  display: flex;
  height: 100rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--muted);
}

.tab-item.on {
  color: var(--accent);
}

.tab-text {
  font-size: 22rpx;
  font-weight: 500;
}

.tab-item.on .tab-text {
  font-weight: 600;
}

.theme-ink .tab {
  border-top: 1rpx solid rgba(212, 165, 116, 0.28);
}

.theme-ink .tab-text {
  font-family: "Songti SC", "STSong", serif;
  letter-spacing: 0.24em;
  font-size: 24rpx;
}

.theme-ink .tab-item.on .tab-text {
  color: #D4A574;
}

.theme-wechat .tab {
  border-top: 1rpx solid #E5E5E5;
}

.theme-family .tab {
  border-top: 0;
  box-shadow: 0 -12rpx 32rpx rgba(255, 107, 61, 0.1);
}

.theme-family .tab-row {
  height: 112rpx;
}

.theme-family .tab-text {
  font-size: 24rpx;
  font-weight: 700;
}

.theme-biz .tab {
  background: #F4F7FA;
  border-top: 1rpx solid rgba(18, 52, 79, 0.1);
}

.theme-biz .tab-item {
  color: #8AA0B4;
}

.theme-biz .tab-item.on {
  color: #12344F;
  box-shadow: none;
}

.theme-biz .tab-text {
  font-size: 20rpx;
  letter-spacing: 0.04em;
}

.theme-biz .safe {
  background: #F4F7FA;
}

.glyph {
  width: 40rpx;
  height: 40rpx;
  position: relative;
  opacity: 0.55;
}

.glyph.on {
  opacity: 1;
}

.g-home {
  border: 3rpx solid currentColor;
  border-top: 0;
  width: 28rpx;
  height: 22rpx;
  margin-top: 10rpx;
  box-sizing: border-box;
}

.g-home::before {
  content: "";
  position: absolute;
  left: -8rpx;
  top: -14rpx;
  width: 0;
  height: 0;
  border-left: 22rpx solid transparent;
  border-right: 22rpx solid transparent;
  border-bottom: 16rpx solid currentColor;
}

.g-near {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid currentColor;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
  margin-top: 6rpx;
  box-sizing: border-box;
}

.g-near::after {
  content: "";
  position: absolute;
  left: 5rpx;
  top: 5rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: currentColor;
}

.g-member {
  width: 34rpx;
  height: 24rpx;
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
  margin-top: 8rpx;
  box-sizing: border-box;
}

.g-member::after {
  content: "";
  position: absolute;
  left: 6rpx;
  top: 8rpx;
  width: 16rpx;
  height: 3rpx;
  background: currentColor;
}

.g-mine {
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  margin-top: 2rpx;
  box-sizing: border-box;
}

.g-mine::after {
  content: "";
  position: absolute;
  left: -8rpx;
  top: 22rpx;
  width: 28rpx;
  height: 12rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 14rpx 14rpx 0 0;
}

.theme-family .g-home,
.theme-family .g-near,
.theme-family .g-member,
.theme-family .g-mine {
  border-radius: 50%;
}

.safe {
  height: env(safe-area-inset-bottom);
  background: var(--tab-bg);
}
