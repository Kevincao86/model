@import "../../styles/tokens.wxss";

.ss {
  display: flex;
  gap: 10rpx;
  padding: 12rpx 0 8rpx;
}

.ss-btn {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 16rpx;
  background: var(--surface);
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 600;
  border: 2rpx solid var(--line);
  box-sizing: border-box;
}

.ss-btn.on {
  background: var(--accent);
  color: var(--on-accent);
  border-color: transparent;
}

.ss-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.ss-btn.on .ss-dot {
  box-shadow: 0 0 0 3rpx rgba(255, 255, 255, 0.45);
}

.ss-family .ss-btn,
.theme-family .ss-btn {
  border-radius: 999rpx;
}

.theme-biz .ss {
  padding-bottom: 16rpx;
}

.theme-biz .ss-btn {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.7);
  border-color: rgba(255, 255, 255, 0.14);
}

.theme-biz .ss-btn.on {
  background: #fff;
  color: #12344F;
}
