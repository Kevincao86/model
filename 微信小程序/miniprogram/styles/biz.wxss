/* 宴请台：酒店预订式店照卡片，不是表格 */

.theme-biz .body {
  padding: 20rpx 24rpx calc(180rpx + env(safe-area-inset-bottom));
}

.biz-search {
  height: 80rpx;
  padding: 0 28rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 28rpx rgba(18, 52, 79, 0.08);
  color: #8AA0B4;
  font-size: 26rpx;
  display: flex;
  align-items: center;
}

.biz-stats,
.biz-dash {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.biz-stat,
.biz-dash-item {
  flex: 1;
  padding: 24rpx 8rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  text-align: center;
  font-size: 20rpx;
  color: #6A7F91;
  box-shadow: 0 8rpx 28rpx rgba(18, 52, 79, 0.06);
}

.biz-stat-n,
.biz-dash-n {
  display: block;
  margin-bottom: 6rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #12344F;
  font-variant-numeric: tabular-nums;
}

.biz-pills {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.biz-pill {
  display: inline-flex;
  height: 56rpx;
  padding: 0 24rpx;
  margin-right: 12rpx;
  border-radius: 12rpx;
  background: #fff;
  color: #6A7F91;
  font-size: 22rpx;
  align-items: center;
}

.biz-pill.on {
  background: #12344F;
  color: #fff;
  font-weight: 600;
}

.biz-h {
  display: block;
  margin: 8rpx 0 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #12344F;
}

.biz-quick {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.biz-quick-i {
  width: calc(50% - 6rpx);
  height: 88rpx;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #12344F;
  box-shadow: 0 8rpx 28rpx rgba(18, 52, 79, 0.06);
}

.biz-card {
  display: flex;
  gap: 20rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 32rpx rgba(18, 52, 79, 0.08);
}

.biz-card-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  background: #DCE3EA;
}

.biz-card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.biz-card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #12344F;
  line-height: 1.3;
}

.biz-card-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6A7F91;
}

.biz-card-foot {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12rpx;
}

.biz-card-price {
  font-size: 24rpx;
  color: #12344F;
}

.biz-card-btn {
  height: 56rpx;
  padding: 0 22rpx;
  background: #12344F;
  color: #fff;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}

.biz-me {
  position: relative;
  height: 280rpx;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.biz-me-img {
  width: 100%;
  height: 100%;
  display: block;
}

.biz-me::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 70%;
  background: linear-gradient(180deg, transparent, rgba(18, 52, 79, 0.88));
}

.biz-me-copy {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 24rpx;
  z-index: 1;
  color: #fff;
}

.biz-me-n {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
}

.biz-me-s {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

.biz-menu {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  margin-bottom: 12rpx;
  background: #fff;
  border-radius: 16rpx;
}

.biz-menu-k {
  font-size: 28rpx;
  color: #12344F;
}

.biz-menu-v {
  font-size: 24rpx;
  color: #6A7F91;
}
