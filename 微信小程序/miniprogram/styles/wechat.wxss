/* 点评绿：美团/大众点评式宫格 + 白底列表 */

.theme-wechat .body {
  padding: 0 0 calc(160rpx + env(safe-area-inset-bottom));
}

.wx-grid {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  padding: 20rpx 0 8rpx;
}

.wx-grid-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 22rpx;
  color: #191919;
}

.wx-grid-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  margin-bottom: 8rpx;
  background: #F7F7F7;
}

.wx-notice {
  margin: 16rpx 24rpx;
  padding: 16rpx 20rpx;
  background: #FFF8E8;
  color: #9A6B2F;
  font-size: 22rpx;
  border-radius: 8rpx;
}

.wx-coupon-scroll {
  white-space: nowrap;
  padding: 0 24rpx 16rpx;
}

.wx-coupon {
  display: inline-flex;
  width: 420rpx;
  height: 148rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 8rpx;
  overflow: hidden;
  vertical-align: top;
}

.wx-coupon-full {
  display: flex;
  width: auto;
  margin: 0 24rpx 16rpx;
}

.wx-coupon-l {
  width: 160rpx;
  background: #07C160;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.wx-coupon-l::after,
.wx-coupon-l::before {
  content: "";
  position: absolute;
  right: -10rpx;
  width: 20rpx;
  height: 20rpx;
  background: #EDEDED;
  border-radius: 50%;
}

.wx-coupon-full .wx-coupon-l::after,
.wx-coupon-full .wx-coupon-l::before {
  background: #EDEDED;
}

.wx-coupon-l::before {
  top: -10rpx;
}

.wx-coupon-l::after {
  bottom: -10rpx;
}

.wx-coupon-yen {
  font-size: 40rpx;
  font-weight: 600;
}

.wx-coupon-r {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  font-size: 26rpx;
  white-space: normal;
}

.wx-coupon-use {
  font-size: 22rpx;
  color: #07C160;
}

.wx-sec {
  padding: 20rpx 24rpx 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.wx-cell {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #F0F0F0;
}

.wx-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  background: #F7F7F7;
}

.wx-cell-body {
  flex: 1;
  min-width: 0;
}

.wx-cell-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.wx-cell-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #888;
}

.wx-cell-dish {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #07C160;
}

.wx-pay {
  flex-shrink: 0;
  height: 56rpx;
  padding: 0 22rpx;
  background: #07C160;
  color: #fff;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}

.wx-payhead {
  background: #07C160;
  color: #fff;
  padding: 36rpx 32rpx 40rpx;
}

.wx-payhead-l {
  display: block;
  font-size: 22rpx;
  opacity: 0.85;
}

.wx-payhead-n {
  display: block;
  margin-top: 8rpx;
  font-size: 64rpx;
  font-weight: 600;
  letter-spacing: -0.03em;
}

.wx-menu {
  background: #fff;
  margin-bottom: 16rpx;
}

.wx-menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-top: 1rpx solid #F0F0F0;
  font-size: 28rpx;
}

.wx-menu-item:first-child {
  border-top: 0;
}

.wx-menu-v {
  color: #888;
  font-size: 24rpx;
}

.wx-filter {
  white-space: nowrap;
  background: #fff;
  padding: 16rpx 24rpx;
  margin-bottom: 8rpx;
}

.wx-fchip {
  display: inline-flex;
  height: 56rpx;
  padding: 0 22rpx;
  margin-right: 12rpx;
  border-radius: 8rpx;
  background: #F7F7F7;
  color: #888;
  font-size: 22rpx;
  align-items: center;
}

.wx-fchip.on {
  background: #07C160;
  color: #fff;
}

.wx-cardpack {
  background: linear-gradient(160deg, #07C160, #06AD56);
  color: #fff;
  padding: 36rpx 32rpx;
  margin-bottom: 16rpx;
}

.wx-cardpack-l {
  font-size: 22rpx;
  opacity: 0.85;
}

.wx-cardpack-n {
  display: block;
  margin: 8rpx 0 20rpx;
  font-size: 72rpx;
  font-weight: 600;
  line-height: 1;
}

.wx-cardpack-ops {
  display: flex;
  gap: 32rpx;
  font-size: 24rpx;
}

.wx-me {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #fff;
  padding: 32rpx 24rpx;
  margin-bottom: 16rpx;
}

.wx-avatar {
  width: 112rpx;
  height: 112rpx;
  background: #07C160;
  color: #fff;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
}

.wx-me-n {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
}

.wx-me-s {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #888;
}
